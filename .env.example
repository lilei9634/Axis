# 复制为 .env 后按需修改。所有 AXIS_ 开头的变量都对应 axis/config.py 里的配置项。

# Claude API 密钥（https://console.anthropic.com）
ANTHROPIC_API_KEY=

# 模型与思考深度（low / medium / high / xhigh / max）
AXIS_REVIEW_MODEL=claude-opus-5-5
AXIS_REVIEW_EFFORT=medium
AXIS_DIAGNOSE_MODEL=claude-opus-5-5
AXIS_DIAGNOSE_EFFORT=high

# 飞书自定义机器人
AXIS_FEISHU_WEBHOOK=
AXIS_FEISHU_SECRET=

# 赛狐：登录页地址、网页调用的接口域名（从抓包结果里确认）
AXIS_SELLFOX_LOGIN_URL=
AXIS_SELLFOX_BASE_URL=
AXIS_SELLFOX_MIN_INTERVAL=1.5
AXIS_SELLFOX_JITTER=1.0

# 存储（迁移到服务器时可以换成 Postgres：postgresql+psycopg://user:pass@host/axis）
AXIS_DB_URL=sqlite:///data/axis.db
AXIS_REPORTS_DIR=reports

# 定时任务
AXIS_TIMEZONE=Asia/Shanghai
AXIS_DAILY_RUN_TIME=09:05
AXIS_SYNC_DAYS=14

# 规则阈值（按自己的品类和利润结构调整）
AXIS_THRESHOLDS__TARGET_ACOS=0.30
AXIS_THRESHOLDS__TARGET_TACOS=0.12
AXIS_THRESHOLDS__MIN_CLICKS_NO_ORDER=15
AXIS_THRESHOLDS__MIN_SPEND_NO_ORDER=10
AXIS_THRESHOLDS__STOCK_DAYS_MIN=21
